NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_DISABLE_KITE_BADGE=false

# Forwarded by /api/v1/kite-platform/contact-form/submit to the Kite platform email API.
PLATFORM_BASE_URL=
PLATFORM_API_KEY=

# Used by the bot-prerender middleware (Prerender.io).
PRERENDER_TOKEN=

# ─── WooCommerce ─────────────────────────────────────────────────────────────
# Base URL of the WordPress/WooCommerce install. Drives catalogue reads
# (Store API), the checkout handoff and the My Account link. No API keys are
# needed: Store API catalogue endpoints are public and read-only.
NEXT_PUBLIC_WP_URL=https://store.furrytailjoy.com

# ─── Nector rewards widget ───────────────────────────────────────────────────
# Public key (build-time). The signing secret is NOT set here - it lives in
# wp-config.php as FT_NECTOR_SIGNING_SECRET; see wordpress/mu-plugins/ft-nector.php.
NEXT_PUBLIC_NECTOR_API_KEY=

# ─── Contact form (Brevo) ────────────────────────────────────────────────────
# Server-only, so unlike NEXT_PUBLIC_* these are read at RUNTIME - set them in
# hPanel and restart; no rebuild needed.
#   BREVO_API_KEY       Brevo -> SMTP & API -> API Keys (v3)
#   CONTACT_TO_EMAIL    where enquiries land
#   CONTACT_FROM_EMAIL  must be a sender Brevo has verified for this domain
BREVO_API_KEY=
CONTACT_TO_EMAIL=orders@furrytailjoy.com
CONTACT_FROM_EMAIL=orders@furrytailjoy.com

# ─── Hostinger CDN auto-purge ────────────────────────────────────────────────
# Hostinger's CDN does not purge on deploy. Next's chunk filenames are
# content-hashed, so an edge-cached document from the previous build requests
# chunks that no longer exist - the stylesheet 404s and the site paints with no
# CSS at all until the browser reloads. src/instrumentation.ts purges once on
# server start (a deploy here means restarting the Web App), and
# scripts/purge-cdn.ps1 does it on demand.
#
# All three must be set or the purge is skipped silently.
#   HOSTINGER_API_TOKEN         hpanel.hostinger.com/api
#                               (hPanel sidebar > Dev tools > API)
#   HOSTINGER_ACCOUNT_USERNAME  hosting account username, not the domain
#                               (scripts/purge-cdn.ps1 prints it)
HOSTINGER_API_TOKEN=
HOSTINGER_ACCOUNT_USERNAME=
HOSTINGER_PURGE_DOMAIN=furrytailjoy.com
