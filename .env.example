NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_DISABLE_KITE_BADGE=false

# Forwarded by /api/v1/kite-platform/contact-form/submit to the Kite platform email API.
PLATFORM_BASE_URL=
PLATFORM_API_KEY=

# Used by the bot-prerender middleware (Prerender.io).
PRERENDER_TOKEN=

# ─── WooCommerce ─────────────────────────────────────────────────────────────
# Base URL of the WordPress/WooCommerce install. Drives catalogue reads
# (Store API), the checkout handoff and the My Account link. No API keys are
# needed: Store API catalogue endpoints are public and read-only.
NEXT_PUBLIC_WP_URL=https://store.furrytailjoy.com

# ─── Contact form (Brevo) ────────────────────────────────────────────────────
# Server-only, so unlike NEXT_PUBLIC_* these are read at RUNTIME - set them in
# hPanel and restart; no rebuild needed.
#   BREVO_API_KEY       Brevo -> SMTP & API -> API Keys (v3)
#   CONTACT_TO_EMAIL    where enquiries land
#   CONTACT_FROM_EMAIL  must be a sender Brevo has verified for this domain
BREVO_API_KEY=
CONTACT_TO_EMAIL=orders@furrytailjoy.com
CONTACT_FROM_EMAIL=orders@furrytailjoy.com
