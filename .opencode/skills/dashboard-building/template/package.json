{
  "name": "kite-team-portal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.17.1",
    "pnpm": "~10.14.0"
  },
  "scripts": {
    "generate:pages": "node scripts/generate-page-registry.mjs",
    "dev": "pnpm generate:pages && next dev -p 4321",
    "build": "pnpm typecheck && next build",
    "start": "next start -p 4321",
    "typecheck": "pnpm generate:pages && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "6.2.3",
    "lucide-react": "^0.525.0",
    "next": "16.2.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "^22.17.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "8.5.15",
    "prettier": "3.6.2",
    "tailwindcss": "4.2.2",
    "typescript": "^5.8.3"
  }
